NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Cloudflare Turnstile 사이트 키(공개돼도 됨). 비밀 키(Secret key)는 여기가 아니라 Supabase 대시보드의 CAPTCHA 설정에 넣는다.
# 비워 두면 로그인·가입 화면에 봇 확인을 띄우지 않는다(Supabase 에서 CAPTCHA 를 켜기 전까지만 비워 둘 것)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 서버 전용 (NEXT_PUBLIC_ 금지). 프로필 사진 API(src/app/api/avatar/route.ts)에서만 사용
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_VISION_API_KEY=
# (선택) Vision 월 호출 상한. 기본 950 (월 무료 1,000건 직전에서 사진 올리기를 막음)
# VISION_MONTHLY_LIMIT=950
