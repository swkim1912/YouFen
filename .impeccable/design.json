      "html": "<div class=\"ds-match ds-win\"><b class=\"ds-res\">승</b><span class=\"ds-dot ds-dot-m\"></span><span class=\"ds-opp\">상대 회원</span><span class=\"ds-score\">15 : 11</span><span class=\"ds-meta\">오픈 · 10.08</span></div><div class=\"ds-match ds-loss\"><b class=\"ds-res\">패</b><span class=\"ds-dot\"></span><span class=\"ds-opp\">비회원 상대</span><span class=\"ds-score\">3 : 5</span><span class=\"ds-meta\">대회 · 09.21</span></div>",
      "css": ".ds-match{font-family:'Pretendard Variable', Pretendard, 'Malgun Gothic', system-ui, sans-serif;letter-spacing:-0.01em;font-variant-numeric:tabular-nums;display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:6px;font-size:14px;color:#e7edf5;margin-bottom:6px;} .ds-win{background:rgb(79 141 255 / .15);} .ds-loss{background:rgb(240 97 107 / .15);} .ds-res{width:20px;font-weight:700;} .ds-win .ds-res{color:#4f8dff;} .ds-loss .ds-res{color:#f0616b;} .ds-dot{width:8px;height:8px;border-radius:9999px;background:rgb(139 154 176 / .5);} .ds-dot-m{background:#34d399;} .ds-opp{flex:1;} .ds-score{font-weight:600;} .ds-meta{font-size:12px;color:#8b9ab0;}"
